<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_surface"
    android:orientation="vertical"
    android:padding="15dp">

  <!-- Header Row -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

    <ImageView
        android:id="@+id/widget_brand_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:scaleType="fitCenter"
        android:src="@drawable/app_icon" />

    <TextView
        android:id="@+id/widget_badge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/misans_regular"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Monitor · 自动模式"
        android:textColor="@color/widget_accent"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/widget_refresh_btn"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="刷新小组件"
        android:padding="5dp"
        android:src="@drawable/ic_widget_refresh" />

    <ImageView
        android:id="@+id/widget_config_btn"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="2dp"
        android:contentDescription="小组件设置"
        android:padding="5dp"
        android:src="@drawable/ic_widget_settings" />
  </LinearLayout>

  <!-- Main Two-Column Content -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_marginTop="6dp"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="horizontal">

    <!-- Left Primary Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.35"
        android:orientation="vertical">

      <TextView
          android:id="@+id/widget_primary_value"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:fontFamily="@font/misans_regular"
          android:includeFontPadding="false"
          android:maxLines="2"
          android:text="—"
          android:textColor="@color/widget_text"
          android:textSize="22sp"
          android:textStyle="bold" />

      <TextView
          android:id="@+id/widget_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="3dp"
          android:ellipsize="end"
          android:fontFamily="@font/misans_regular"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="等待数据同步"
          android:textColor="@color/widget_text"
          android:textSize="12.5sp" />

      <ProgressBar
          android:id="@+id/widget_progress"
          style="?android:attr/progressBarStyleHorizontal"
          android:layout_width="match_parent"
          android:layout_height="6dp"
          android:layout_marginTop="6dp"
          android:max="100"
          android:progress="0"
          android:progressDrawable="@drawable/widget_progress_bar" />
    </LinearLayout>

    <!-- Right Secondary Capsule -->
    <LinearLayout
        android:id="@+id/widget_side_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="0.95"
        android:background="@drawable/widget_pill_surface"
        android:orientation="vertical"
        android:padding="10dp">

      <TextView
          android:id="@+id/widget_side_label"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:fontFamily="@font/misans_regular"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="今日 Token"
          android:textColor="@color/widget_muted"
          android:textSize="11sp" />

      <TextView
          android:id="@+id/widget_side_value"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="3dp"
          android:ellipsize="end"
          android:fontFamily="@font/misans_regular"
          android:includeFontPadding="false"
          android:maxLines="2"
          android:text="—"
          android:textColor="@color/widget_text"
          android:textSize="14sp"
          android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>

  <!-- Bottom Reset / Tracking Note -->
  <TextView
      android:id="@+id/widget_footer"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:ellipsize="end"
      android:fontFamily="@font/misans_regular"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:text="点按打开 Monitor"
      android:textColor="@color/widget_muted"
      android:textSize="11sp" />
</LinearLayout>
