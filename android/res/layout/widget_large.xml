<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_surface"
    android:orientation="vertical"
    android:padding="16dp">

  <!-- Header Row -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

    <ImageView
        android:id="@+id/widget_brand_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:scaleType="fitCenter"
        android:src="@drawable/app_icon" />

    <TextView
        android:id="@+id/widget_badge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/misans_regular"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Monitor · 工作台"
        android:textColor="@color/widget_accent"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/widget_refresh_btn"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:contentDescription="刷新小组件"
        android:padding="5dp"
        android:src="@drawable/ic_widget_refresh" />

    <ImageView
        android:id="@+id/widget_config_btn"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="2dp"
        android:contentDescription="小组件设置"
        android:padding="5dp"
        android:src="@drawable/ic_widget_settings" />
  </LinearLayout>

  <!-- Hero Focus Card (Tracked Project OR Lowest Official Quota) -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:background="@drawable/widget_pill_surface"
      android:orientation="vertical"
      android:padding="12dp">

    <TextView
        android:id="@+id/widget_primary_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/misans_regular"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="—"
        android:textColor="@color/widget_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="@font/misans_regular"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="等待数据同步"
        android:textColor="@color/widget_text"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_bar" />

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/misans_regular"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="点按查看详情"
        android:textColor="@color/widget_muted"
        android:textSize="11.5sp" />
  </LinearLayout>

  <!-- Secondary Details Section (Other Quotas / Today Per-Tool Tokens / Active Tasks) -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_marginTop="10dp"
      android:layout_weight="1"
      android:orientation="vertical">

    <TextView
        android:id="@+id/widget_section_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/misans_regular"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="今日用量与活跃任务"
        android:textColor="@color/widget_muted"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/misans_regular"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="—"
        android:textColor="@color/widget_text"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/widget_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:fontFamily="@font/misans_regular"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text=""
        android:textColor="@color/widget_text"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/widget_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:fontFamily="@font/misans_regular"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text=""
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />
  </LinearLayout>
</LinearLayout>
