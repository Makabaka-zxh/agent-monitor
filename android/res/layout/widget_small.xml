<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_surface"
    android:orientation="vertical"
    android:padding="13dp">

  <!-- Top Row: Brand Icon + Header Tag + Settings Gear -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

    <ImageView
        android:id="@+id/widget_brand_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/app_icon" />

    <TextView
        android:id="@+id/widget_badge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/misans_regular"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Monitor"
        android:textColor="@color/widget_accent"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/widget_config_btn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="小组件设置"
        android:padding="3dp"
        android:src="@drawable/ic_widget_settings" />
  </LinearLayout>

  <!-- Center Hero Value -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="vertical">

    <TextView
        android:id="@+id/widget_primary_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/misans_regular"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="—"
        android:textColor="@color/widget_text"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="@font/misans_regular"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="等待连接"
        android:textColor="@color/widget_muted"
        android:textSize="11.5sp" />
  </LinearLayout>

  <!-- Bottom Reset / Secondary Line -->
  <TextView
      android:id="@+id/widget_footer"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:fontFamily="@font/misans_regular"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:text="点按查看详情"
      android:textColor="@color/widget_muted"
      android:textSize="10.5sp" />
</LinearLayout>
