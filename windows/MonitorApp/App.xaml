<Application x:Class="MonitorApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="UI/MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="MonitorScrollThumbIdleBrush" Color="#335F6B78" />
        <SolidColorBrush x:Key="MonitorScrollThumbHoverBrush" Color="#78466987" />
        <SolidColorBrush x:Key="MonitorAccentBrush" Color="#FF466987" />
        <SolidColorBrush x:Key="MonitorOnAccentBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="MonitorControlBgBrush" Color="#CCF6F9FC" />
        <SolidColorBrush x:Key="MonitorControlBorderBrush" Color="#FFBCC9D6" />
        <SolidColorBrush x:Key="MonitorControlHoverBrush" Color="#FFE8EFF6" />
        <SolidColorBrush x:Key="MonitorTooltipBgBrush" Color="#F21E2730" />
        <SolidColorBrush x:Key="MonitorTooltipBorderBrush" Color="#44AFC8DF" />
        <SolidColorBrush x:Key="MonitorTooltipTextBrush" Color="#FFF4F7FB" />

        <!-- Luxury Rounded Tooltip -->
        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Placement" Value="Mouse" />
            <Setter Property="VerticalOffset" Value="12" />
            <Setter Property="HorizontalOffset" Value="6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MonitorTooltipTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolTip}">
                        <Border Background="{DynamicResource MonitorTooltipBgBrush}"
                                BorderBrush="{DynamicResource MonitorTooltipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,5.5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bespoke Squircle CheckBox -->
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBoxBorder"
                                    Grid.Column="0"
                                    Width="18"
                                    Height="18"
                                    Margin="0,1,9,1"
                                    CornerRadius="4.5"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Background="{DynamicResource MonitorControlBgBrush}"
                                    BorderBrush="{DynamicResource MonitorControlBorderBrush}"
                                    BorderThickness="1.2">
                                <Path x:Name="CheckMark"
                                      Data="M 3.6,9.1 L 7.1,12.6 L 14.1,5.2"
                                      Stroke="{DynamicResource MonitorOnAccentBrush}"
                                      StrokeThickness="1.85"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource MonitorAccentBrush}" />
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource MonitorControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource MonitorAccentBrush}" />
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource MonitorAccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bespoke Concentric RadioButton -->
        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="RadioOuter"
                                    Grid.Column="0"
                                    Width="18"
                                    Height="18"
                                    Margin="0,1,9,1"
                                    CornerRadius="9"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Background="{DynamicResource MonitorControlBgBrush}"
                                    BorderBrush="{DynamicResource MonitorControlBorderBrush}"
                                    BorderThickness="1.25">
                                <Border x:Name="RadioInner"
                                        Width="8.5"
                                        Height="8.5"
                                        CornerRadius="4.25"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource MonitorAccentBrush}"
                                        Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RadioOuter" Property="BorderBrush" Value="{DynamicResource MonitorAccentBrush}" />
                                <Setter TargetName="RadioOuter" Property="Background" Value="{DynamicResource MonitorControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RadioOuter" Property="BorderBrush" Value="{DynamicResource MonitorAccentBrush}" />
                                <Setter TargetName="RadioInner" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonitorScrollPageButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="MonitorVerticalThumbTemplate" TargetType="{x:Type Thumb}">
            <Border Background="Transparent" Padding="1.5,0,1.5,0">
                <Border x:Name="ThumbVisual"
                        Width="4"
                        CornerRadius="2"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource MonitorScrollThumbIdleBrush}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ThumbVisual" Property="Width" Value="5.5" />
                    <Setter TargetName="ThumbVisual" Property="CornerRadius" Value="2.75" />
                    <Setter TargetName="ThumbVisual" Property="Background" Value="{DynamicResource MonitorScrollThumbHoverBrush}" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter TargetName="ThumbVisual" Property="Width" Value="5.5" />
                    <Setter TargetName="ThumbVisual" Property="CornerRadius" Value="2.75" />
                    <Setter TargetName="ThumbVisual" Property="Background" Value="{DynamicResource MonitorScrollThumbHoverBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="MonitorHorizontalThumbTemplate" TargetType="{x:Type Thumb}">
            <Border Background="Transparent" Padding="0,1.5,0,1.5">
                <Border x:Name="ThumbVisual"
                        Height="4"
                        CornerRadius="2"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource MonitorScrollThumbIdleBrush}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ThumbVisual" Property="Height" Value="5.5" />
                    <Setter TargetName="ThumbVisual" Property="CornerRadius" Value="2.75" />
                    <Setter TargetName="ThumbVisual" Property="Background" Value="{DynamicResource MonitorScrollThumbHoverBrush}" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter TargetName="ThumbVisual" Property="Height" Value="5.5" />
                    <Setter TargetName="ThumbVisual" Property="CornerRadius" Value="2.75" />
                    <Setter TargetName="ThumbVisual" Property="Background" Value="{DynamicResource MonitorScrollThumbHoverBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Margin" Value="0,4,2,4" />
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource MonitorScrollPageButtonStyle}" Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Template="{StaticResource MonitorVerticalThumbTemplate}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource MonitorScrollPageButtonStyle}" Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1.0" />
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="8" />
                    <Setter Property="MinHeight" Value="8" />
                    <Setter Property="Margin" Value="4,0,4,2" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False" Focusable="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource MonitorScrollPageButtonStyle}" Command="ScrollBar.PageLeftCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Template="{StaticResource MonitorHorizontalThumbTemplate}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource MonitorScrollPageButtonStyle}" Command="ScrollBar.PageRightCommand" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
