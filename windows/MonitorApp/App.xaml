<Application x:Class="MonitorApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="UI/MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="MonitorScrollThumbIdleBrush" Color="#335F6B78" />
        <SolidColorBrush x:Key="MonitorScrollThumbHoverBrush" Color="#78466987" />

        <Style x:Key="MonitorScrollPageButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="MonitorVerticalThumbTemplate" TargetType="{x:Type Thumb}">
            <Border Background="Transparent" Padding="1.5,0,1.5,0">
                <Border x:Name="ThumbVisual"
                        Width="4"
                        CornerRadius="2"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource MonitorScrollThumbIdleBrush}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ThumbVisual" Property="Width" Value="5.5" />
                    <Setter TargetName="ThumbVisual" Property="CornerRadius" Value="2.75" />
                    <Setter TargetName="ThumbVisual" Property="Background" Value="{DynamicResource MonitorScrollThumbHoverBrush}" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter TargetName="ThumbVisual" Property="Width" Value="5.5" />
                    <Setter TargetName="ThumbVisual" Property="CornerRadius" Value="2.75" />
                    <Setter TargetName="ThumbVisual" Property="Background" Value="{DynamicResource MonitorScrollThumbHoverBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="MonitorHorizontalThumbTemplate" TargetType="{x:Type Thumb}">
            <Border Background="Transparent" Padding="0,1.5,0,1.5">
                <Border x:Name="ThumbVisual"
                        Height="4"
                        CornerRadius="2"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource MonitorScrollThumbIdleBrush}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ThumbVisual" Property="Height" Value="5.5" />
                    <Setter TargetName="ThumbVisual" Property="CornerRadius" Value="2.75" />
                    <Setter TargetName="ThumbVisual" Property="Background" Value="{DynamicResource MonitorScrollThumbHoverBrush}" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter TargetName="ThumbVisual" Property="Height" Value="5.5" />
                    <Setter TargetName="ThumbVisual" Property="CornerRadius" Value="2.75" />
                    <Setter TargetName="ThumbVisual" Property="Background" Value="{DynamicResource MonitorScrollThumbHoverBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Margin" Value="0,4,2,4" />
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource MonitorScrollPageButtonStyle}" Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Template="{StaticResource MonitorVerticalThumbTemplate}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource MonitorScrollPageButtonStyle}" Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1.0" />
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="8" />
                    <Setter Property="MinHeight" Value="8" />
                    <Setter Property="Margin" Value="4,0,4,2" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False" Focusable="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource MonitorScrollPageButtonStyle}" Command="ScrollBar.PageLeftCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Template="{StaticResource MonitorHorizontalThumbTemplate}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource MonitorScrollPageButtonStyle}" Command="ScrollBar.PageRightCommand" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
